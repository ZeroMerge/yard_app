{
  "name": "yard-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Yard Creator Marketing Platform Monorepo",
  "workspaces": [
    "packages/*",
    "frontend",
    "admin"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:admin": "npm run dev --workspace=admin",
    "build:frontend": "npm run build --workspace=frontend",
    "build:admin": "npm run build --workspace=admin",
    "prisma:generate": "npm --prefix backend install --include=dev && npm --prefix backend run prisma:generate",
    "build:backend": "npm --prefix backend run build",
    "build": "npm --prefix backend run build",
    "start:prod": "node backend/dist/main.js",
    "start": "node backend/dist/main.js"
  }
}