generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  role         String   // 'brand', 'creator', 'admin'
  status       String   @default("active") // 'active', 'suspended'
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  organizationMembers OrganizationMember[]
  creators            Creator[]
  filesUploaded       File[]
  campaignActivities  CampaignActivity[]
  auditLogs           AuditLog[]

  @@index([role, status])
  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  website   String?
  industry  String?
  createdAt DateTime @default(now()) @map("created_at")

  members   OrganizationMember[]
  campaigns Campaign[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           String       @default("member") // 'owner', 'member'

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

model Creator {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  displayName     String   @map("display_name")
  bio             String?
  profileImageUrl String?  @map("profile_image_url")
  verified        Boolean  @default(false)
  payoutAccount   Json?    @map("payout_account")
  createdAt       DateTime @default(now()) @map("created_at")

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccounts         CreatorSocialAccount[]
  categories             CreatorCategory[]
  languages              CreatorLanguage[]
  locations              CreatorLocation[]
  rates                  CreatorRate[]
  portfolioItems         CreatorPortfolio[]
  applications           Application[]
  stats                  CreatorStats?
  socialMetricSnapshots SocialMetricSnapshot[]
  scores                 CreatorScore[]
  scrapeJobs             ScrapeJob[]

  @@index([userId])
  @@index([verified])
  @@map("creators")
}

model CreatorSocialAccount {
  id         String  @id @default(uuid())
  creatorId  String  @map("creator_id")
  platform   String
  handle     String
  profileUrl String  @map("profile_url")

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, platform])
  @@index([platform, handle])
  @@map("creator_social_accounts")
}

model Platform {
  id   String @id @default(uuid())
  name String @unique // 'instagram', 'tiktok', 'youtube', 'facebook', 'x'

  campaignPlatforms CampaignPlatform[]

  @@map("platforms")
}

model CreatorCategory {
  creatorId String @map("creator_id")
  category  String // beauty, fashion, food, tech, lifestyle, finance, fitness, entertainment, other

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@id([creatorId, category])
  @@index([category])
  @@map("creator_categories")
}

model CreatorLanguage {
  creatorId String @map("creator_id")
  language  String

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@id([creatorId, language])
  @@index([language])
  @@map("creator_languages")
}

model CreatorLocation {
  id        String  @id @default(uuid())
  creatorId String  @map("creator_id")
  country   String
  city      String?

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([country, city])
  @@map("creator_locations")
}

model CreatorRate {
  id              String  @id @default(uuid())
  creatorId       String  @map("creator_id")
  deliverableType String  @map("deliverable_type")
  amount          Decimal @db.Decimal(12, 2)
  currency        String  @default("NGN")

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, deliverableType])
  @@map("creator_rates")
}

model CreatorPortfolio {
  id        String   @id @default(uuid())
  creatorId String   @map("creator_id")
  fileId    String?  @map("file_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  file    File?   @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([creatorId])
  @@map("creator_portfolio")
}

model Campaign {
  id                  String    @id @default(uuid())
  organizationId      String    @map("organization_id")
  name                String
  goal                String    // product_awareness, content_creation, product_review, sales_promotion, event_promotion
  category            String
  country             String
  city                String?
  brief               String
  deliverableType     String    @map("deliverable_type")
  quantity            Int
  budgetPerCreator    Decimal   @map("budget_per_creator") @db.Decimal(12, 2)
  currency            String    @default("NGN")
  status              String    @default("draft") // draft, open, in_progress, review, completed, cancelled, closed
  applicationDeadline DateTime? @map("application_deadline")
  deliveryDeadline    DateTime? @map("delivery_deadline")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platforms    CampaignPlatform[]
  requirements CampaignRequirement[]
  applications Application[]
  deliverables Deliverable[]
  payments     Payment[]
  activities   CampaignActivity[]
  files        File[]

  @@index([organizationId])
  @@index([status])
  @@index([category, country])
  @@index([createdAt])
  @@map("campaigns")
}

model CampaignPlatform {
  campaignId String @map("campaign_id")
  platformId String @map("platform_id")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@id([campaignId, platformId])
  @@map("campaign_platforms")
}

model CampaignRequirement {
  id           String  @id @default(uuid())
  campaignId   String  @map("campaign_id")
  minFollowers Int?    @map("min_followers")
  category     String?
  country      String?
  language     String?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_requirements")
}

model Application {
  id         String    @id @default(uuid())
  campaignId String    @map("campaign_id")
  creatorId  String    @map("creator_id")
  source     String    @default("applied") // applied, invited
  status     String    @default("pending") // pending, accepted, rejected, withdrawn
  pitch      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  decidedAt  DateTime? @map("decided_at")

  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator      Creator       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  deliverables Deliverable[]
  payments     Payment[]

  @@unique([campaignId, creatorId])
  @@index([campaignId, status])
  @@index([creatorId, status])
  @@map("applications")
}

model File {
  id             String   @id @default(uuid())
  campaignId     String?  @map("campaign_id")
  uploadedBy     String   @map("uploaded_by")
  provider       String   // google_drive, cloudinary, s3, local
  providerFileId String   @map("provider_file_id")
  providerUrl    String?  @map("provider_url")
  fileType       String?  @map("file_type")
  fileSize       BigInt?  @map("file_size")
  status         String   @default("active") // active, deleted
  createdAt      DateTime @default(now()) @map("created_at")

  campaign          Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  uploader          User               @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  deliverables      Deliverable[]
  creatorPortfolios CreatorPortfolio[]

  @@index([campaignId])
  @@index([uploadedBy])
  @@index([status])
  @@map("files")
}

model Deliverable {
  id            String    @id @default(uuid())
  campaignId    String    @map("campaign_id")
  applicationId String    @map("application_id")
  fileId        String    @map("file_id")
  status        String    @default("submitted") // submitted, revision_requested, approved, rejected
  revisionNotes String?   @map("revision_notes")
  version       Int       @default(1)
  submittedAt   DateTime  @default(now()) @map("submitted_at")
  reviewedAt    DateTime? @map("reviewed_at")

  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  file        File        @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([applicationId])
  @@index([status])
  @@map("deliverables")
}

model Payment {
  id              String   @id @default(uuid())
  campaignId      String   @map("campaign_id")
  applicationId   String   @map("application_id")
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("NGN")
  provider        String   // flutterwave, paystack
  providerRef     String?  @map("provider_ref")
  status          String   @default("unpaid") // unpaid, payment_initiated, payment_confirmed, creator_payout_pending, paid, failed, retry
  parentPaymentId String?  @map("parent_payment_id")
  createdAt       DateTime @default(now()) @map("created_at")

  campaign      Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  parentPayment Payment?    @relation("PaymentChain", fields: [parentPaymentId], references: [id], onDelete: SetNull)
  childPayments Payment[]   @relation("PaymentChain")

  @@index([campaignId])
  @@index([applicationId])
  @@index([status])
  @@index([providerRef])
  @@index([parentPaymentId])
  @@map("payments")
}

model ProviderEvent {
  id          String    @id @default(uuid())
  provider    String    // paystack, flutterwave
  eventType   String    @map("event_type")
  payload     Json
  processed   Boolean   @default(false)
  retryCount  Int       @default(0) @map("retry_count")
  maxRetries  Int       @default(3) @map("max_retries")
  deadLetter  Boolean   @default(false) @map("dead_letter")
  errorLog    String?   @map("error_log")
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@index([provider, eventType])
  @@index([processed, deadLetter])
  @@index([receivedAt])
  @@map("provider_events")
}

model CampaignActivity {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id")
  actorId    String?  @map("actor_id")
  eventType  String   @map("event_type")
  body       String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt])
  @@index([actorId])
  @@map("campaign_activity")
}

model CreatorStats {
  creatorId           String   @id @map("creator_id")
  campaignsCompleted  Int      @default(0) @map("campaigns_completed")
  campaignsCancelled  Int      @default(0) @map("campaigns_cancelled")
  onTimeDeliveries    Int      @default(0) @map("on_time_deliveries")
  lateDeliveries      Int      @default(0) @map("late_deliveries")
  revisionsRequested Int      @default(0) @map("revisions_requested")
  disputes            Int      @default(0)
  repeatHires         Int      @default(0) @map("repeat_hires")
  updatedAt           DateTime @updatedAt @map("updated_at")

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("creator_stats")
}

model SocialMetricSnapshot {
  id             String   @id @default(uuid())
  creatorId      String   @map("creator_id")
  platform       String
  followers      Int?
  following      Int?
  posts          Int?
  engagementRate Decimal? @map("engagement_rate") @db.Decimal(5, 2)
  capturedAt     DateTime @map("captured_at")
  source         String   // apify, api, manual

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, platform, capturedAt])
  @@map("social_metric_snapshot")
}

model CreatorScore {
  id           String   @id @default(uuid())
  creatorId    String   @map("creator_id")
  score        Decimal? @db.Decimal(5, 2)
  scoreVersion String   @map("score_version")
  calculatedAt DateTime @default(now()) @map("calculated_at")

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, calculatedAt])
  @@map("creator_score")
}

model ScrapeJob {
  id          String    @id @default(uuid())
  creatorId   String    @map("creator_id")
  platform    String
  jobType     String    @map("job_type")
  status      String    @default("queued") // queued, running, completed, failed
  retryCount  Int       @default(0) @map("retry_count")
  maxRetries  Int       @default(3) @map("max_retries")
  errorLog    String?   @map("error_log")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, status])
  @@index([status, createdAt])
  @@map("scrape_job")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@index([action])
  @@map("audit_logs")
}
