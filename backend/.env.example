# ==============================================================================
# CreatorYard Backend Production Environment Configuration Reference
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# URLs & Network
BACKEND_URL="https://api.useyard.dev"
FRONTEND_URL="https://app.useyard.dev"
ALLOWED_ORIGINS="http://localhost:8080,http://127.0.0.1:8080,https://app.useyard.dev,https://useyard.dev"

# Supabase PostgreSQL Database URL (Session or Transaction Pooler)
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# JWT Authentication
JWT_SECRET="generate_a_secure_64_byte_hex_secret_here"
JWT_EXPIRES_IN="7d"

# Payment Providers (Modular: 'paystack' or 'flutterwave')
DEFAULT_PAYMENT_PROVIDER="paystack"

# Paystack (Live & Test keys auto-detected)
PAYSTACK_SECRET_KEY="sk_live_your_production_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="pk_live_your_production_paystack_public_key"

# Flutterwave (Optional fallback)
FLUTTERWAVE_SECRET_KEY="FLWSECK_LIVE-your_key"
FLUTTERWAVE_HASH="your_flutterwave_secret_hash"

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_URL="cloudinary://[api_key]:[api_secret]@[cloud_name]"

# Google Drive (Enterprise backup storage)
GOOGLE_DRIVE_CLIENT_EMAIL="service-account@project.iam.gserviceaccount.com"
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_SHARED_DRIVE_ID="your_shared_drive_folder_id"

# Ingestion & Scraping Provider (Apify)
APIFY_API_TOKEN="apify_api_token_here"

# Ingestion Engine Bridge (Python worker bridge)
INGESTION_ENGINE_URL="http://localhost:8000"
INGESTION_API_BEARER_TOKEN="generate_32_byte_hex_token_here"
INGESTION_WEBHOOK_SECRET="generate_32_byte_hex_secret_here"

# WhatsApp Notifications (EvolutionAPI)
EVOLUTION_API_URL="https://your-evolution-instance.com"
EVOLUTION_API_KEY="your_evolution_api_key"
EVOLUTION_INSTANCE_NAME="yard-notifications"
