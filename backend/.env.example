# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase PostgreSQL Database URL (Session or Transaction Pooler)
DATABASE_URL="postgresql://postgres.example:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# JWT Authentication
JWT_SECRET="your_secure_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# Payment Providers
DEFAULT_PAYMENT_PROVIDER="paystack"
PAYSTACK_SECRET_KEY="your_paystack_secret_key_here"
FLUTTERWAVE_SECRET_KEY="your_flutterwave_secret_key_here"
FLUTTERWAVE_HASH="your_flutterwave_hash_here"

# Media Storage
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
APIFY_API_KEY="your_apify_api_key_here"
